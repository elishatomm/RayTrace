# RayTrace settings. Copy to .env only if you need to override defaults.
# There is no live mode: WORKBENCH_ENV must stay "synthetic" and external actions stay off.
WORKBENCH_ENV=synthetic
# local = fresh inference via local Ollama; recorded = replay stored model output; rules = no model;
# hosted = an OpenAI-compatible API (the WORKBENCH_HOSTED_* settings below, all three required);
# auto = chosen once at start: local if Ollama answers with the model, else hosted if configured, else rules
WORKBENCH_MODEL_MODE=local
# qwen3:8b passed the M0 gate (qwen3:4b did not); see experiments/m0/m0_model_report.json
WORKBENCH_MODEL=qwen3:8b
WORKBENCH_MODEL_THINK=false
# Must be a loopback address; the app refuses a remote model endpoint.
WORKBENCH_OLLAMA_URL=http://127.0.0.1:11434
# The hosted model. Its diagnoses are labelled HOSTED and are not part of the M4 evaluation.
# Base URL: https://<provider-host>/v1, or plain http to a loopback host only (a local OpenAI-compatible server).
# Example, Cloudflare Workers AI (replace <account-id>; the workbench adds /chat/completions):
# WORKBENCH_HOSTED_URL=https://api.cloudflare.com/client/v4/accounts/<account-id>/ai/v1
# WORKBENCH_HOSTED_MODEL=@cf/openai/gpt-oss-20b
WORKBENCH_HOSTED_URL=
WORKBENCH_HOSTED_MODEL=
# A secret: set it in the environment or the host's secret store. It is never printed, logged, stored or sent
# anywhere but the Authorization header to WORKBENCH_HOSTED_URL's host.
WORKBENCH_HOSTED_API_KEY=
# Calls per UTC day for the whole process, repairs included; a call over the budget is not sent.
WORKBENCH_HOSTED_MAX_CALLS_PER_DAY=50
# json_schema_strict, json_schema, json_object or none; use the strongest your provider accepts.
WORKBENCH_HOSTED_RESPONSE_FORMAT=json_schema
# 0 to 2, or none to send no temperature (for a provider that refuses one below 1, or with reasoning on).
WORKBENCH_HOSTED_TEMPERATURE=0
# Unset sends none; otherwise none, low, medium or high, sent as reasoning_effort.
WORKBENCH_HOSTED_REASONING_EFFORT=
WORKBENCH_ALLOW_EXTERNAL_ACTIONS=false
WORKBENCH_MODEL_MAX_CALLS=4
WORKBENCH_TOOL_MAX_CALLS=6
WORKBENCH_RUN_TIMEOUT_SECONDS=90
WORKBENCH_DATA_DIR=./local_data
# Recovery timing on the replay clock: plan and approval lifetimes, provider-evidence freshness
WORKBENCH_PLAN_TTL_SECONDS=1800
WORKBENCH_APPROVAL_TTL_SECONDS=900
WORKBENCH_STALE_AFTER_SECONDS=3600
# Public mode (docs/DEMO_HOSTING.md, section 3.3): off while WORKBENCH_PUBLIC_ORIGIN is empty. Set it to the one https
# origin viewers open, such as https://<name>.<host>, and the server answers only that Host and Origin, takes the
# token below, and refuses to start if any value here is unsafe. --host 0.0.0.0 is allowed only in public mode, and
# the port comes from $PORT when the host sets it.
WORKBENCH_PUBLIC_ORIGIN=
# The shared demo token, set in the host's secret store, never in this file. Generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# Public mode refuses to start unless it has that shape: 43 to 256 characters, at least 3 uppercase and 3 lowercase
# letters, 1 digit and 20 different characters, and no 8-character sequence that occurs twice. Anyone may test guesses
# against it, so it must be generated, never chosen. About 1 generated token in 1,600 has no digit and is refused: generate another.
WORKBENCH_DEMO_TOKEN=
# The seeds a viewer may seed, separated by commas; a run that exists already is opened, not refused.
WORKBENCH_PUBLIC_SEEDS=101
WORKBENCH_PUBLIC_RUNS_PER_SESSION=3
WORKBENCH_PUBLIC_RUNS_PER_PROCESS=30
# No new run once the data directory holds this much. Public mode empties the data directory at every start, so it must
# be new and empty, or one public mode marked as its own.
WORKBENCH_PUBLIC_DATA_LIMIT_MB=200
# The demo runs the production image holds (Q48), as an absolute path; the image sets it. Public mode copies them into
# its emptied data directory at every start, and their bytes count toward the limit above. Empty: every run is seeded
# when a viewer asks.
WORKBENCH_PUBLIC_TEMPLATE_DIR=
# The host's proxy addresses or networks, comma-separated, whose X-Forwarded-For the server believes; never *. Empty:
# no forwarded header is believed and there is no per-address limit.
WORKBENCH_PUBLIC_TRUSTED_PROXIES=
