      "text": "diff --git a/merchant_app/checkout.py b/merchant_app/checkout.py\nindex c21ef6c..98e6acc 100644\n--- a/merchant_app/checkout.py\n+++ b/merchant_app/checkout.py\n@@ -1,7 +1,7 @@\n \"\"\"Payment options the storefront offers at checkout.\"\"\"\n from merchant_app import config\n \n-METHOD_ORDER = (\"card\", \"upi\", \"netbanking\")\n+METHOD_ORDER = (\"upi\", \"card\", \"netbanking\")\n \n # Netbanking bank codes, most used first.\n NETBANKING_BANKS = (\"NB04\", \"NB01\", \"NB03\", \"NB02\")\n"
