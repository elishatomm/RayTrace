        "summary": "Extract fulfilment and settlement helpers"
      },
      "text": "diff --git a/merchant_app/orders.py b/merchant_app/orders.py\nindex 14967cd..8f6969d 100644\n--- a/merchant_app/orders.py\n+++ b/merchant_app/orders.py\n@@ -6,18 +6,27 @@\n     \"\"\"The event's amount cannot settle an order.\"\"\"\n \n \n+def check_settlement(order_id, amount_paise, currency):\n+    \"\"\"Raise unless the amount and currency can settle the order in full.\"\"\"\n+    if not isinstance(amount_paise, int) or amount_paise <= 0:\n+        raise InvalidOrderAmount(f\"order {order_id}: expected positive integer paise, got {amount_paise!r}\")\n+    if currency != config.CURRENCY:\n+        raise InvalidOrderAmount(f\"order {order_id}: unsupported currency {currency!r}\")\n+\n+\n+def fulfilment(order_id, payment_id, amount_paise, currency):\n+    \"\"\"The instruction that ships one order once its payment settles it.\"\"\"\n+    check_settlement(order_id, amount_paise, currency)\n+    return {\n+        \"action\": \"fulfil\",\n+        \"order_id\": order_id,\n+        \"payment_id\": payment_id,\n+        \"amount_paise\": amount_paise,\n+        \"currency\": currency,\n+    }\n+\n+\n def build_instruction(parsed):\n     if parsed[\"event_type\"] not in config.FULFIL_ON_EVENTS:\n         return {\"action\": \"ignore\"}\n-    amount_paise = parsed[\"amount_paise\"]\n-    if not isinstance(amount_paise, int) or amount_paise <= 0:\n-        raise InvalidOrderAmount(f\"order {parsed['order_id']}: expected positive integer paise, got {amount_paise!r}\")\n-    if parsed[\"currency\"] != config.CURRENCY:\n-        raise InvalidOrderAmount(f\"order {parsed['order_id']}: unsupported currency {parsed['currency']!r}\")\n-    return {\n-        \"action\": \"fulfil\",\n-        \"order_id\": parsed[\"order_id\"],\n-        \"payment_id\": parsed[\"payment_id\"],\n-        \"amount_paise\": amount_paise,\n-        \"currency\": parsed[\"currency\"],\n-    }\n+    return fulfilment(**parsed)\n"
    },
    {
      "evidence_id": "ev_deploy_3f61a8344a",
      "kind": "deployment",
      "known_at_ms": 1793960293000,
      "title": "Deployment deploy_3f61a8344a to order_worker",
      "facts": {
        "deploy_id": "deploy_3f61a8344a",
        "service": "order_worker",
        "kind": "code",
        "deployed_at_ms": 1793960293000,
        "files_changed": [
          "merchant_app/handler.py"
        ],
        "summary": "Time each handled event"
      },
      "text": "diff --git a/merchant_app/handler.py b/merchant_app/handler.py\nindex d631706..ce746df 100644\n--- a/merchant_app/handler.py\n+++ b/merchant_app/handler.py\n@@ -1,5 +1,14 @@\n \"\"\"Entry point the worker calls once for each committed webhook event.\"\"\"\n+import logging\n+import time\n+from collections import Counter\n+\n from merchant_app import orders, payload\n+\n+log = logging.getLogger(__name__)\n+\n+# Events handled since the worker started, by event type and outcome; the worker's metrics endpoint reads it.\n+HANDLED_EVENTS = Counter()\n \n \n class ErrorBoundary:\n@@ -18,7 +27,16 @@\n \n \n def handle_event(event):\n-    with ErrorBoundary(\"event_parse_error\"):\n-        parsed = payload.parse_event(event)\n-    with ErrorBoundary(\"order_validation_error\"):\n-        return orders.build_instruction(parsed)\n+    started = time.monotonic()\n+    outcome = \"raised\"\n+    try:\n+        with ErrorBoundary(\"event_parse_error\"):\n+            parsed = payload.parse_event(event)\n+        with ErrorBoundary(\"order_validation_error\"):\n+            instruction = orders.build_instruction(parsed)\n+        outcome = instruction[\"action\"]\n+        return instruction\n+    finally:\n+        HANDLED_EVENTS[(event.get(\"event\"), outcome)] += 1\n+        elapsed_ms = (time.monotonic() - started) * 1000\n+        log.debug(\"handled %s as %s in %.1f ms\", event.get(\"event\"), outcome, elapsed_ms)\n"
    },
