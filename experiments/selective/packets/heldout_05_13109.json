    {
      "evidence_id": "ev_deploy_aa8c156434",
      "kind": "deployment",
      "known_at_ms": 1794046446000,
      "title": "Deployment deploy_aa8c156434 to order_worker",
      "facts": {
        "deploy_id": "deploy_aa8c156434",
        "service": "order_worker",
        "kind": "code",
        "deployed_at_ms": 1794046446000,
        "files_changed": [
          "merchant_app/payload.py"
        ],
        "summary": "Parse payment amounts into a money object"
      },
      "text": "diff --git a/merchant_app/payload.py b/merchant_app/payload.py\nindex e881edd..976b291 100644\n--- a/merchant_app/payload.py\n+++ b/merchant_app/payload.py\n@@ -8,17 +8,25 @@\n     \"\"\"The integration does not subscribe to this event type.\"\"\"\n \n \n+def money(payment):\n+    \"\"\"Amount, refunded amount and currency as one value, so no consumer pairs paise with the wrong currency.\"\"\"\n+    return {\n+        \"paise\": payment[\"amount\"],\n+        \"refunded_paise\": payment[\"amount_refunded\"],\n+        \"currency\": payment[\"currency\"],\n+    }\n+\n+\n def parse_event(event):\n     event_type = event[\"event\"]\n     if event_type not in SUPPORTED_EVENTS:\n         raise UnsupportedEvent(f\"unsupported event type {event_type!r}\")\n-    entity = event[\"payload\"][\"payment\"][\"entity\"]\n+    payment = event[\"payload\"][\"payment\"][\"entity\"]\n     return {\n         \"event_type\": event_type,\n-        \"payment_id\": entity[\"id\"],\n-        \"order_id\": entity[config.ORDER_REFERENCE_FIELD],\n-        \"status\": entity[\"status\"],\n-        \"method\": entity.get(\"method\"),\n-        \"amount_paise\": entity[\"amount\"],\n-        \"currency\": entity[\"currency\"],\n+        \"payment_id\": payment[\"id\"],\n+        \"order_id\": payment[config.ORDER_REFERENCE_FIELD],\n+        \"status\": payment[\"status\"],\n+        \"method\": payment.get(\"method\"),\n+        \"amount\": money(payment),\n     }\n"
    },
    {
      "evidence_id": "ev_deploy_e18aec2b0e",
      "kind": "deployment",
      "known_at_ms": 1794047179000,
      "title": "Deployment deploy_e18aec2b0e to order_worker",
      "facts": {
        "deploy_id": "deploy_e18aec2b0e",
        "service": "order_worker",
        "kind": "code",
        "deployed_at_ms": 1794047179000,
        "files_changed": [
          "merchant_app/handler.py"
        ],
        "summary": "Explain how stage tags are kept in the handler"
      },
      "text": "diff --git a/merchant_app/handler.py b/merchant_app/handler.py\nindex d631706..1a79a59 100644\n--- a/merchant_app/handler.py\n+++ b/merchant_app/handler.py\n@@ -1,9 +1,18 @@\n-\"\"\"Entry point the worker calls once for each committed webhook event.\"\"\"\n+\"\"\"Entry point the worker calls once for each committed webhook event.\n+\n+The worker passes the event exactly as the provider delivered it, after the receiver has checked its\n+signature and stored it. Parsing and the order decision run in separate error boundaries, so a failure\n+is logged with the stage it came from.\n+\"\"\"\n from merchant_app import orders, payload\n \n \n class ErrorBoundary:\n-    \"\"\"Tag an exception with the processing stage it escaped from, for structured error logs.\"\"\"\n+    \"\"\"Tag an exception with the processing stage it escaped from, for structured error logs.\n+\n+    The tag is set on the exception object, so it survives being re-raised by outer code. The\n+    boundary never suppresses an exception.\n+    \"\"\"\n \n     def __init__(self, stage):\n         self.stage = stage\n@@ -12,12 +21,17 @@\n         return self\n \n     def __exit__(self, exc_type, exc, tb):\n+        # Keep a tag set by an inner boundary: it names the stage closest to where the exception started.\n         if exc is not None and not hasattr(exc, \"error_boundary\"):\n             exc.error_boundary = self.stage\n         return False\n \n \n def handle_event(event):\n+    \"\"\"Return the instruction for one event: fulfil its order, or ignore the event.\n+\n+    Exceptions propagate unchanged; the worker records them and tries the event again later.\n+    \"\"\"\n     with ErrorBoundary(\"event_parse_error\"):\n         parsed = payload.parse_event(event)\n     with ErrorBoundary(\"order_validation_error\"):\n"
    },
