    {
      "evidence_id": "ev_deploy_20e8af5099",
      "kind": "deployment",
      "known_at_ms": 1793787255000,
      "title": "Deployment deploy_20e8af5099 to order_worker",
      "facts": {
        "deploy_id": "deploy_20e8af5099",
        "service": "order_worker",
        "kind": "code",
        "deployed_at_ms": 1793787255000,
        "files_changed": [
          "merchant_app/payload.py"
        ],
        "summary": "Start the dispatch SLA clock at capture"
      },
      "text": "diff --git a/merchant_app/payload.py b/merchant_app/payload.py\nindex e881edd..415e0d4 100644\n--- a/merchant_app/payload.py\n+++ b/merchant_app/payload.py\n@@ -2,10 +2,16 @@\n from merchant_app import config\n \n SUPPORTED_EVENTS = (\"payment.authorized\", \"payment.captured\", \"payment.failed\")\n+CAPTURED_EVENT = \"payment.captured\"\n \n \n class UnsupportedEvent(ValueError):\n     \"\"\"The integration does not subscribe to this event type.\"\"\"\n+\n+\n+def epoch_ms(seconds):\n+    \"\"\"Provider timestamps are whole seconds; the dispatch SLA clock counts milliseconds.\"\"\"\n+    return seconds * 1000\n \n \n def parse_event(event):\n@@ -13,7 +19,7 @@\n     if event_type not in SUPPORTED_EVENTS:\n         raise UnsupportedEvent(f\"unsupported event type {event_type!r}\")\n     entity = event[\"payload\"][\"payment\"][\"entity\"]\n-    return {\n+    parsed = {\n         \"event_type\": event_type,\n         \"payment_id\": entity[\"id\"],\n         \"order_id\": entity[config.ORDER_REFERENCE_FIELD],\n@@ -22,3 +28,7 @@\n         \"amount_paise\": entity[\"amount\"],\n         \"currency\": entity[\"currency\"],\n     }\n+    if event_type == CAPTURED_EVENT:\n+        # Dispatch is promised within 24 hours of capture, so the SLA clock starts at the capture itself.\n+        parsed[\"captured_at_ms\"] = epoch_ms(entity[\"captured_at\"])\n+    return parsed\n"
    },
    {
      "evidence_id": "ev_deploy_b2dacd9886",
      "kind": "deployment",
      "known_at_ms": 1793787963000,
      "title": "Deployment deploy_b2dacd9886 to order_worker",
      "facts": {
        "deploy_id": "deploy_b2dacd9886",
        "service": "order_worker",
        "kind": "code",
        "deployed_at_ms": 1793787963000,
        "files_changed": [
          "merchant_app/handler.py"
        ],
        "summary": "Add handling-time debug log and event counters"
      },
      "text": "diff --git a/merchant_app/handler.py b/merchant_app/handler.py\nindex d631706..ce746df 100644\n--- a/merchant_app/handler.py\n+++ b/merchant_app/handler.py\n@@ -1,5 +1,14 @@\n \"\"\"Entry point the worker calls once for each committed webhook event.\"\"\"\n+import logging\n+import time\n+from collections import Counter\n+\n from merchant_app import orders, payload\n+\n+log = logging.getLogger(__name__)\n+\n+# Events handled since the worker started, by event type and outcome; the worker's metrics endpoint reads it.\n+HANDLED_EVENTS = Counter()\n \n \n class ErrorBoundary:\n@@ -18,7 +27,16 @@\n \n \n def handle_event(event):\n-    with ErrorBoundary(\"event_parse_error\"):\n-        parsed = payload.parse_event(event)\n-    with ErrorBoundary(\"order_validation_error\"):\n-        return orders.build_instruction(parsed)\n+    started = time.monotonic()\n+    outcome = \"raised\"\n+    try:\n+        with ErrorBoundary(\"event_parse_error\"):\n+            parsed = payload.parse_event(event)\n+        with ErrorBoundary(\"order_validation_error\"):\n+            instruction = orders.build_instruction(parsed)\n+        outcome = instruction[\"action\"]\n+        return instruction\n+    finally:\n+        HANDLED_EVENTS[(event.get(\"event\"), outcome)] += 1\n+        elapsed_ms = (time.monotonic() - started) * 1000\n+        log.debug(\"handled %s as %s in %.1f ms\", event.get(\"event\"), outcome, elapsed_ms)\n"
    },
