        "summary": "Accept payment.captured.v2 ahead of the webhook API upgrade"
      },
      "text": "diff --git a/merchant_app/config.py b/merchant_app/config.py\nindex 7e37456..e4a4cd8 100644\n--- a/merchant_app/config.py\n+++ b/merchant_app/config.py\n@@ -1,4 +1,5 @@\n \"\"\"Settings shared by the storefront, the webhook receiver and the order worker.\"\"\"\n+import re\n \n CURRENCY = \"INR\"\n \n@@ -6,7 +7,8 @@\n ORDER_REFERENCE_FIELD = \"order_id\"\n \n # Events that complete an order. An authorisation on its own never ships anything.\n-FULFIL_ON_EVENTS = (\"payment.captured\",)\n+# A pattern rather than a list: the provider's next webhook API sends versioned names such as payment.captured.v2.\n+FULFIL_ON_EVENTS = re.compile(r\"payment\\.captured(\\.v\\d+)?\")\n \n # Name of the signing secret deliveries are verified with; the value lives in the secret store.\n WEBHOOK_SECRET_REF = \"webhook_secret_primary\"\n"
    },
    {
      "evidence_id": "ev_deploy_a4b7302c4d",
      "kind": "deployment",
      "known_at_ms": 1793960785000,
      "title": "Deployment deploy_a4b7302c4d to storefront",
      "facts": {
        "deploy_id": "deploy_a4b7302c4d",
        "service": "storefront",
        "kind": "code",
        "deployed_at_ms": 1793960785000,
        "files_changed": [
          "merchant_app/checkout.py"
        ],
        "summary": "Add card instalment tenures to checkout options"
      },
      "text": "diff --git a/merchant_app/checkout.py b/merchant_app/checkout.py\nindex c21ef6c..7b124c3 100644\n--- a/merchant_app/checkout.py\n+++ b/merchant_app/checkout.py\n@@ -5,6 +5,17 @@\n \n # Netbanking bank codes, most used first.\n NETBANKING_BANKS = (\"NB04\", \"NB01\", \"NB03\", \"NB02\")\n+\n+# Card instalments start at this order value; below it the monthly amounts are too small to be worth offering.\n+EMI_MIN_AMOUNT_PAISE = 3_00_000\n+EMI_TENURES_MONTHS = (3, 6, 9, 12)\n+\n+\n+def emi_tenures(amount_paise):\n+    \"\"\"Instalment plans offered on a card payment for an order of this value.\"\"\"\n+    if amount_paise < EMI_MIN_AMOUNT_PAISE:\n+        return []\n+    return list(EMI_TENURES_MONTHS)\n \n \n def checkout_options(order_id, amount_paise):\n@@ -15,5 +26,6 @@\n         \"methods\": list(METHOD_ORDER),\n         \"default_method\": METHOD_ORDER[0],\n         \"netbanking_banks\": list(NETBANKING_BANKS),\n+        \"card_emi_tenures_months\": emi_tenures(amount_paise),\n         \"session_ttl_seconds\": config.CHECKOUT_SESSION_TTL_SECONDS,\n     }\n"
    },
