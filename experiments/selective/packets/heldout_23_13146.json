    {
      "evidence_id": "ev_deploy_cfcf3a922c",
      "kind": "deployment",
      "known_at_ms": 1793614459000,
      "title": "Deployment deploy_cfcf3a922c to order_worker",
      "facts": {
        "deploy_id": "deploy_cfcf3a922c",
        "service": "order_worker",
        "kind": "code",
        "deployed_at_ms": 1793614459000,
        "files_changed": [
          "merchant_app/payload.py"
        ],
        "summary": "Parse payment amounts into a money object"
      },
      "text": "diff --git a/merchant_app/payload.py b/merchant_app/payload.py\nindex e881edd..976b291 100644\n--- a/merchant_app/payload.py\n+++ b/merchant_app/payload.py\n@@ -8,17 +8,25 @@\n     \"\"\"The integration does not subscribe to this event type.\"\"\"\n \n \n+def money(payment):\n+    \"\"\"Amount, refunded amount and currency as one value, so no consumer pairs paise with the wrong currency.\"\"\"\n+    return {\n+        \"paise\": payment[\"amount\"],\n+        \"refunded_paise\": payment[\"amount_refunded\"],\n+        \"currency\": payment[\"currency\"],\n+    }\n+\n+\n def parse_event(event):\n     event_type = event[\"event\"]\n     if event_type not in SUPPORTED_EVENTS:\n         raise UnsupportedEvent(f\"unsupported event type {event_type!r}\")\n-    entity = event[\"payload\"][\"payment\"][\"entity\"]\n+    payment = event[\"payload\"][\"payment\"][\"entity\"]\n     return {\n         \"event_type\": event_type,\n-        \"payment_id\": entity[\"id\"],\n-        \"order_id\": entity[config.ORDER_REFERENCE_FIELD],\n-        \"status\": entity[\"status\"],\n-        \"method\": entity.get(\"method\"),\n-        \"amount_paise\": entity[\"amount\"],\n-        \"currency\": entity[\"currency\"],\n+        \"payment_id\": payment[\"id\"],\n+        \"order_id\": payment[config.ORDER_REFERENCE_FIELD],\n+        \"status\": payment[\"status\"],\n+        \"method\": payment.get(\"method\"),\n+        \"amount\": money(payment),\n     }\n"
    },
    {
      "evidence_id": "ev_deploy_1be6d8a9ca",
      "kind": "deployment",
      "known_at_ms": 1793614688000,
      "title": "Deployment deploy_1be6d8a9ca to order_worker",
      "facts": {
        "deploy_id": "deploy_1be6d8a9ca",
        "service": "order_worker",
        "kind": "code",
        "deployed_at_ms": 1793614688000,
        "files_changed": [
          "merchant_app/orders.py"
        ],
        "summary": "Name parsed events consistently in orders.py"
      },
      "text": "diff --git a/merchant_app/orders.py b/merchant_app/orders.py\nindex 14967cd..4e2be04 100644\n--- a/merchant_app/orders.py\n+++ b/merchant_app/orders.py\n@@ -6,18 +6,31 @@\n     \"\"\"The event's amount cannot settle an order.\"\"\"\n \n \n-def build_instruction(parsed):\n-    if parsed[\"event_type\"] not in config.FULFIL_ON_EVENTS:\n+def settlement_problem(event):\n+    \"\"\"Why the event's amount or currency cannot settle its order, or None when it can.\"\"\"\n+    amount_paise = event[\"amount_paise\"]\n+    if not isinstance(amount_paise, int) or amount_paise <= 0:\n+        return f\"expected positive integer paise, got {amount_paise!r}\"\n+    if event[\"currency\"] != config.CURRENCY:\n+        return f\"unsupported currency {event['currency']!r}\"\n+    return None\n+\n+\n+def instruction_for(event):\n+    \"\"\"What the order system does with one parsed payment event.\"\"\"\n+    if event[\"event_type\"] not in config.FULFIL_ON_EVENTS:\n         return {\"action\": \"ignore\"}\n-    amount_paise = parsed[\"amount_paise\"]\n-    if not isinstance(amount_paise, int) or amount_paise <= 0:\n-        raise InvalidOrderAmount(f\"order {parsed['order_id']}: expected positive integer paise, got {amount_paise!r}\")\n-    if parsed[\"currency\"] != config.CURRENCY:\n-        raise InvalidOrderAmount(f\"order {parsed['order_id']}: unsupported currency {parsed['currency']!r}\")\n+    problem = settlement_problem(event)\n+    if problem is not None:\n+        raise InvalidOrderAmount(f\"order {event['order_id']}: {problem}\")\n     return {\n         \"action\": \"fulfil\",\n-        \"order_id\": parsed[\"order_id\"],\n-        \"payment_id\": parsed[\"payment_id\"],\n-        \"amount_paise\": amount_paise,\n-        \"currency\": parsed[\"currency\"],\n+        \"order_id\": event[\"order_id\"],\n+        \"payment_id\": event[\"payment_id\"],\n+        \"amount_paise\": event[\"amount_paise\"],\n+        \"currency\": event[\"currency\"],\n     }\n+\n+\n+# The handler and the order service still call the old name; drop it once both call instruction_for.\n+build_instruction = instruction_for\n"
    },
